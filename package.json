{
    "name": "@posty5/lang-detect",
    "version": "1.0.0",
    "description": "Unified language detection for Node.js, Angular SSR, and browser — strategy-based with configurable priority stages",
    "main": "./dist/index.js",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "homepage": "https://github.com/Posty5/lang-detect",
    "repository": {
        "type": "git",
        "url": "https://github.com/Posty5/lang-detect"
    },
    "publishConfig": {
        "access": "public"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs",
            "require": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "jest",
        "test:watch": "jest --watch",
        "typecheck": "tsc --noEmit",
        "prepublishOnly": "npm run build"
    },
    "keywords": [
        "posty5",
        "language-detection",
        "i18n",
        "locale",
        "express-middleware",
        "angular-ssr",
        "accept-language",
        "geoip"
    ],
    "author": "Posty5",
    "license": "MIT",
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.11",
        "@types/node": "^20.0.0",
        "express": "^4.18.0",
        "cookie-parser": "^1.4.6",
        "@types/cookie-parser": "^1.4.6",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.1",
        "typescript": "^5.3.0",
        "tsup": "^8.0.0"
    },
    "peerDependencies": {
        "geoip-country": ">=4.0.0"
    },
    "peerDependenciesMeta": {
        "geoip-country": {
            "optional": true
        }
    },
    "engines": {
        "node": ">=16.0.0"
    }
}